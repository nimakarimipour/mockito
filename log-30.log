              }
            }
          } finally {
            isSuspended.set(false);
          }
          return null;
        };

    bytecodeGenerator =
        new TypeCachingBytecodeGenerator(
            new InlineBytecodeGenerator(
                INSTRUMENTATION, mocks, mockedStatics, isMockConstruction, onConstruction),
            true);
}
