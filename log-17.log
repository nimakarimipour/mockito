    if (isMultiline() || (!matchers.isEmpty() && invocationString.length() > MAX_LINE_LENGTH)) {
      return qualifiedName + matchersPrinter.getArgumentsBlock(matchers, this);
    } else {
      return invocationString;
    }
}
